# Frontend / Node
node_modules/
dist/
build/
.next/
.cache/
.parcel-cache/
.vite/

# The 'build/' pattern above is unanchored — without this negation it
# would also match the .claude/skills/build/ skill folder. Keep the
# build skill tracked.
!.claude/skills/build/

# .NET / API
bin/
obj/
*.user
*.suo
*.publishsettings

# Environment / secrets
.env
.env.local
.env.*.local

# Test / coverage outputs
coverage/
.nyc_output/
test-results/
playwright-report/

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude Code workflow state — per-machine, never tracked
.claude/worktrees/
.claude/.commit-allowed
.claude/.undo-keepalive

# Review cache — produced per-run, not committed
artifacts/docs/dev/reviews/.last-clean-run.json

# Demo launcher logs (demo-start.cmd / demo-start.ps1)
.demo-logs/

# Dev-only auth bypass scaffolding — local demo only, MUST NOT ship to any
# environment with real Entra wiring. These files short-circuit token
# validation so the SPA + API run against LocalDB without a tenant. If they
# land in dev/staging/prod they silently disable auth.
api/src/ContractManager.Api/DevBypass/
web/src/auth/devAuth.tsx

# Word-doc artifacts generated from Markdown handoff docs
artifacts/docs/dev/*.docx
